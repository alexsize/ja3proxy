{
  "openapi": "3.1.0",
  "info": {
    "title": "Локальный API регистратора JA3Proxy",
    "version": "0.5.0",
    "description": "Наблюдения в ограниченной памяти. Доступ только через loopback с проверкой Host, адреса клиента и Origin; аутентификация пользователей пока отсутствует. Это не полный API центра управления."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9090"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "recorderStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "stats": {
                      "$ref": "#/components/schemas/Stats"
                    }
                  },
                  "required": [
                    "enabled",
                    "stats"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Отклонён нелокальный клиент, Host или Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/observations": {
      "get": {
        "operationId": "listObservations",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Observation"
                      }
                    },
                    "next_cursor": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Недопустимый лимит",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Курсор вытеснен из окна памяти",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Сначала возвращаются новые обработанные записи. В списке отсутствуют decoded, raw и normalized данные. Курсор — ID сохранённого наблюдения; после его вытеснения возвращается 409."
      }
    },
    "/api/v1/observations/{id}": {
      "get": {
        "operationId": "getObservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Наблюдение уже не хранится",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/observations/{id}/reparse": {
      "post": {
        "operationId": "reparseObservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Создана новая analysis revision; исходное наблюдение сохранено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Наблюдение уже не хранится",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "RAW ClientHello не сохранён или не разбирается текущим parser",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Recorder отключён или уже закрыт",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Повторно разбирает сохранённый RAW ClientHello, добавляя новую analysis revision и не изменяя исходную запись. Доступно только для запуска с включённым raw capture."
      }
    },
    "/api/v1/fingerprints/diff": {
      "get": {
        "operationId": "compareObservations",
        "parameters": [
          {
            "name": "a",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "b",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comparison"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Оба наблюдения должны находиться в окне памяти",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Сравниваются два наблюдения. Проверка ожидаемого шаблона находится в поле verification исходящего наблюдения."
      }
    },
    "/api/v1/export/observations": {
      "get": {
        "operationId": "exportRetainedObservations",
        "description": "Экспортирует только текущее окно памяти, начиная с новых записей. Raw-данные присутствуют только при включении во время запуска.",
        "responses": {
          "200": {
            "description": "Поток NDJSON",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tls/presets": {
      "get": {
        "operationId": "listCompiledPresets",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "403": {
            "description": "Отклонён нелокальный клиент, Host или Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tls/profiles": {
      "get": {
        "operationId": "listTLSProfiles",
        "responses": {
          "200": {
            "description": "Версионируемая библиотека TLS-профилей",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfileLibrary"}}}
          }
        }
      },
      "post": {
        "operationId": "createTLSProfile",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfileMutation"}}}},
        "responses": {
          "201": {"description": "Профиль создан"},
          "409": {"description": "Устаревшая config_version"}
        }
      }
    },
    "/api/v1/tls/profiles/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {
        "operationId": "getTLSProfile",
        "responses": {"200": {"description": "TLS-профиль", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfile"}}}}, "404": {"description": "Профиль не найден"}}
      },
      "put": {
        "operationId": "updateTLSProfile",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfileMutation"}}}},
        "responses": {"200": {"description": "Создана новая версия профиля"}, "409": {"description": "Устаревшая config_version"}}
      },
      "delete": {
        "operationId": "deleteTLSProfile",
        "description": "Удаляет неактивный профиль из текущего snapshot. Предыдущие snapshot остаются в append-only журнале.",
        "responses": {"200": {"description": "Обновлённая библиотека"}, "400": {"description": "Активный профиль сначала нужно отключить"}, "409": {"description": "Устаревшая config_version"}}
      }
    },
    "/api/v1/tls/profiles/{id}/versions": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {
        "operationId": "getTLSProfileVersions",
        "description": "Возвращает неизменяемую историю опубликованных версий профиля.",
        "responses": {"200": {"description": "История версий", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/TLSProfile"}}}}}, "404": {"description": "История не найдена"}}
      }
    },
    "/api/v1/tls/profiles/{id}/rollback": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "post": {
        "operationId": "rollbackTLSProfile",
        "description": "Создаёт новую версию на основе исторической; существующие версии не изменяются.",
        "responses": {"200": {"description": "Создана новая версия профиля"}, "409": {"description": "Устаревшая config_version"}}
      }
    },
    "/api/v1/tls/profiles/from-preset": {
      "post": {
        "operationId": "profileFromPreset",
        "description": "Создаёт несохранённый редактируемый шаблон из uTLS-пресета.",
        "responses": {"200": {"description": "Черновик", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfile"}}}}}
      }
    },
    "/api/v1/tls/profiles/from-observation": {
      "post": {
        "operationId": "profileFromObservation",
        "description": "Создаёт черновик или сохраняет профиль из полного ClientHello в окне recorder.",
        "responses": {"200": {"description": "Черновик"}, "201": {"description": "Профиль сохранён"}, "404": {"description": "Наблюдение недоступно"}}
      }
    },
    "/api/v1/tls/profiles/preview": {
      "post": {
        "operationId": "previewTLSProfile",
        "description": "Материализует ClientHello, проверяет воспроизводимость и вычисляет ожидаемые JA3/JA4/TLS-NORM.",
        "responses": {"200": {"description": "Пересчитанный шаблон", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TLSProfile"}}}}}
      }
    },
    "/api/v1/tls/profiles/active": {
      "put": {
        "operationId": "activateTLSProfile",
        "description": "Атомарно выбирает профиль для новых соединений; пустой id отключает пользовательский шаблон.",
        "responses": {"200": {"description": "Обновлённая библиотека"}, "409": {"description": "Устаревшая config_version"}}
      }
    },
    "/metrics": {
      "get": {
        "operationId": "recorderMetrics",
        "responses": {
          "200": {
            "description": "Счётчики и gauge регистратора в формате Prometheus",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Требуется локальный доступ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "live"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Отклонён нелокальный клиент, Host или Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "recording_degraded": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Отклонён нелокальный клиент, Host или Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Stats": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "processed": {
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "write_errors": {
            "type": "integer",
            "minimum": 0
          },
          "queue_depth": {
            "type": "integer",
            "minimum": 0
          },
          "recent": {
            "type": "integer",
            "minimum": 0
          },
          "memory_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "recording_degraded": {
            "type": "boolean"
          }
        }
      },
      "Observation": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "tls-observation/2"
          },
          "capture_version": {
            "const": 1
          },
          "parser_version": {
            "const": "1.0.0"
          },
          "ja3_version": {
            "const": "JA3/1"
          },
          "ja4_version": {
            "const": "FoxIO-JA4-TCP/2026-09-22"
          },
          "tls_norm_version": {
            "const": "TLS-NORM-1"
          },
          "tls_engine": {
            "enum": ["utls", "external"]
          },
          "tls_engine_version": {
            "type": "string"
          },
          "analysis_revision": {
            "type": "integer",
            "minimum": 1
          },
          "analysis_parent_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "connection_id": {
            "type": "string"
          },
          "capture_point": {
            "enum": [
              "CLIENT_IN",
              "PROXY_OUT"
            ]
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "byte_source": {
            "enum": ["client_socket_read", "upstream_socket_successful_write"]
          },
          "mode": {
            "enum": [
              "MITM_REISSUE",
              "PASSTHROUGH",
              "OBSERVE_ONLY"
            ]
          },
          "destination": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "profile_version": {
            "type": "integer"
          },
          "config_version": {
            "type": "integer"
          },
          "runtime_mutations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeMutation"
            }
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time"
          },
          "completeness": {
            "enum": [
              "complete",
              "not_tls",
              "truncated",
              "malformed",
              "timeout"
            ]
          },
          "error_code": {
            "type": "string"
          },
          "record_version": {
            "type": "integer"
          },
          "record_count": {
            "type": "integer"
          },
          "declared_hello_length": {
            "type": "integer"
          },
          "decoded": {
            "type": "object",
            "additionalProperties": true
          },
          "fingerprints": {
            "$ref": "#/components/schemas/Fingerprints"
          },
          "verification": {
            "$ref": "#/components/schemas/Verification"
          },
          "forwarding": {
            "$ref": "#/components/schemas/ForwardingVerification"
          },
          "raw_client_hello": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "raw_records": {
            "type": "string",
            "contentEncoding": "base64"
          }
        },
        "required": [
          "schema_version",
          "capture_version",
          "parser_version",
          "ja3_version",
          "ja4_version",
          "tls_norm_version",
          "tls_engine",
          "tls_engine_version",
          "analysis_revision",
          "id",
          "connection_id",
          "capture_point",
          "direction",
          "byte_source",
          "completeness",
          "captured_at",
          "processed_at"
        ]
      },
      "Fingerprints": {
        "type": "object",
        "properties": {
          "ja3": {
            "type": "string"
          },
          "ja3_hash": {
            "type": "string"
          },
          "ja3_version": {
            "type": "string"
          },
          "ja4": {
            "type": "string"
          },
          "ja4_a": {
            "type": "string"
          },
          "ja4_b": {
            "type": "string"
          },
          "ja4_c": {
            "type": "string"
          },
          "ja4_version": {
            "type": "string"
          },
          "fingerprint_model": {
            "type": "string",
            "const": "TLS-FP/1"
          },
          "handshake_type": {
            "enum": ["FULL", "RESUMED", "PSK"]
          },
          "session_resumption": {
            "type": "boolean"
          },
          "psk_present": {
            "type": "boolean"
          },
          "psk_identity_count": {
            "type": "integer",
            "minimum": 0
          },
          "early_data": {
            "type": "boolean"
          },
          "normalization_version": {
            "type": "string"
          },
          "implementation_version": {
            "type": "string"
          },
          "raw_sha256": {
            "type": "string"
          },
          "records_sha256": {
            "type": "string"
          },
          "normalized_sha256": {
            "type": "string"
          },
          "normalized": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "RuntimeMutation": {
        "type": "object",
        "properties": {
          "type": {
            "const": "PROFILE_RUNTIME_MUTATION"
          },
          "field": {
            "enum": ["ALPN", "ALPS"]
          },
          "before": {
            "type": "array",
            "items": {"type": "string"}
          },
          "after": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["type", "field", "before", "after", "reason"]
      },
      "Comparison": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          }
        },
        "required": [
          "status",
          "changes"
        ]
      },
      "Verification": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "tls-profile-verification/1"},
          "status": {"enum": ["MATCH", "PARTIAL_MATCH", "MISMATCH", "UNKNOWN"]},
          "reason": {"type": "string"},
          "expected": {"type": "object", "additionalProperties": true},
          "actual_ja3": {"type": "string"},
          "actual_ja3_hash": {"type": "string"},
          "actual_ja4": {"type": "string"},
          "actual_normalized_sha256": {"type": "string"},
          "diff_algorithm_version": {"type": "string"},
          "changes": {"type": "array", "items": {"$ref": "#/components/schemas/Change"}}
        },
        "required": ["schema_version", "status", "expected", "diff_algorithm_version", "changes"]
      },
      "ForwardingVerification": {
        "type": "object",
        "description": "Доказательство неизменной передачи ClientHello в PASSTHROUGH/OBSERVE_ONLY.",
        "properties": {
          "status": {"enum": ["FORWARDED_UNCHANGED", "MISMATCH", "UNVERIFIED"]},
          "reason": {"type": "string"},
          "inbound_raw_sha256": {"type": "string"},
          "outbound_raw_sha256": {"type": "string"},
          "inbound_records_sha256": {"type": "string"},
          "outbound_records_sha256": {"type": "string"}
        },
        "required": ["status"]
      },
      "TLSProfileLibrary": {
        "type": "object",
        "properties": {
          "schema_version": {"const": "tls-profile-template/1"},
          "config_version": {"type": "integer"},
          "active_id": {"type": "string"},
          "templates": {"type": "array", "items": {"$ref": "#/components/schemas/TLSProfile"}}
        },
        "required": ["schema_version", "config_version", "templates"]
      },
      "TLSProfile": {
        "type": "object",
        "description": "Версионируемый шаблон ClientHello. Поля expected и replayability пересчитываются сервером.",
        "additionalProperties": true,
        "properties": {
          "schema_version": {"const": "tls-profile-template/1"},
          "id": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "integer"},
          "based_on_version": {"type": "integer"},
          "enabled": {"type": "boolean"},
          "host_patterns": {"type": "array", "items": {"type": "string"}},
          "base_preset": {"type": "object", "additionalProperties": true},
          "fields": {
            "type": "object",
            "properties": {
              "alpn_policy": {
                "enum": ["PROFILE", "DOWNSTREAM", "INTERSECTION", "CUSTOM"]
              },
              "custom_alpn": {
                "type": "array",
                "items": {"type": "string"}
              },
              "alps": {
                "type": "array",
                "items": {"type": "string"}
              },
              "alps_policy": {
                "enum": ["PROFILE", "DOWNSTREAM", "INTERSECTION", "CUSTOM"]
              },
              "custom_alps": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": true
          },
          "policy": {"type": "object", "additionalProperties": true},
          "source": {"type": ["object", "null"], "additionalProperties": true},
          "expected": {"type": ["object", "null"], "additionalProperties": true},
          "replayability": {"type": "object", "additionalProperties": true}
        }
      },
      "TLSProfileMutation": {
        "type": "object",
        "properties": {
          "expected_version": {"type": "integer"},
          "template": {"$ref": "#/components/schemas/TLSProfile"}
        },
        "required": ["expected_version", "template"]
      },
      "Change": {
        "type": "object",
        "properties": {
          "op": {
            "enum": [
              "add",
              "remove",
              "replace",
              "move"
            ]
          },
          "path": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "before": {},
          "after": {}
        },
        "required": [
          "op",
          "path"
        ]
      }
    }
  }
}
